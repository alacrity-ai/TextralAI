      "enabled": true,
      "default_model": {
        "provider": "openai",
        "model": "gpt-4o-mini"
      },
      "passes": [
        {
          "id": "endpoint_reference",
          "scope": "section",
          "required": false,
          "depends_on": [],
          "artifact_namespace": "technical",
          "produces": [
            "technical.endpoint"
          ],
          "max_input_tokens": 100000,
          "oversize_strategy": "map_reduce"
        }
      ]
