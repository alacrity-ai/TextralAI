{
  "name": "@textral/profiles",
  "version": "0.2.0",
  "private": false,
  "type": "module",
  "description": "Shared `~/.textral/profiles.toml` resolver. Used by @textral/sdk, @textral/mcp, and any future Node tool that addresses Textral by profile name.",
  "license": "MIT",
  "author": "Alacrity AI",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alacrity-ai/TextralAI.git",
    "directory": "packages/profiles"
  },
  "homepage": "https://github.com/alacrity-ai/TextralAI/tree/main/packages/profiles#readme",
  "bugs": {
    "url": "https://github.com/alacrity-ai/TextralAI/issues"
  },
  "keywords": [
    "textral",
    "profiles",
    "config"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "smol-toml": "^1.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0",
    "vitest": "~3.2.4"
  },
  "engines": {
    "node": ">=22"
  }
}
